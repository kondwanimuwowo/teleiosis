# Environment Variables Template
# Copy this file to .env.local and fill in the values

# ===== SUPABASE (DATABASE) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxx...

# ===== CLOUDFLARE (CDN) =====
# Account ID from Cloudflare dashboard
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_ID=xxxxx
# R2 bucket name (for storing audio files)
NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=teleiosis-audio
# R2 access token (for uploading files)
CLOUDFLARE_R2_ACCESS_KEY=xxxxx
CLOUDFLARE_R2_SECRET_KEY=xxxxx
# CDN URL for accessing audio files
NEXT_PUBLIC_CLOUDFLARE_CDN_URL=https://cdn.teleiosis.org

# ===== STRIPE (PAYMENTS) =====
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===== EMAIL SERVICE =====
# Using Resend (recommended)
RESEND_API_KEY=re_xxxxx
# OR using SendGrid
SENDGRID_API_KEY=SG.xxxxx

# ===== SITE CONFIG =====
NEXT_PUBLIC_SITE_URL=https://teleiosis.org
NEXT_PUBLIC_API_URL=https://api.teleiosis.org

# ===== ANALYTICS =====
NEXT_PUBLIC_GA_ID=G-xxxxx

# ===== CMS (Optional) =====
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxx
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=xxxxx
